FROM node:18.18.2-alpine3.18 AS builder

WORKDIR /home/node

ENV NODE_ENV build

USER node
COPY package*.json ./

RUN npm install

COPY --chown=node:node . .

RUN npm run build && npm prune --production

FROM node:18.18.2-alpine3.18 AS runner

# Set the timezone
RUN apk add --no-cache tzdata

ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}
ARG START_COMMAND=start:prod
ENV START_COMMAND=${START_COMMAND}
ARG ENV_FILE=.env.prod
ENV ENV_FILE=${ENV_FILE}

ENV TZ=Asia/Tehran

WORKDIR /home/node

USER node

COPY package*.json ./
COPY .env.* ./
COPY $ENV_FILE ./.env

RUN mkdir -p ./uploads
RUN chown node:node ./uploads

COPY --from=builder --chown=node:node /home/node/package*.json ./
COPY --from=builder --chown=node:node /home/node/node_modules/ ./node_modules/
COPY --from=builder --chown=node:node /home/node/dist/ ./dist/
COPY --from=builder --chown=node:node /home/node/src/ ./src/
COPY --from=builder --chown=node:node /home/node/tsconfig.* ./
COPY --from=builder --chown=node:node /home/node/nest-cli.json ./

# Add Entrypoint script to run migrations and start the app
CMD npm run $START_COMMAND
